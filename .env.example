# ============================================
# AnuTask — Environment Variables
# Copy to .env.local (dev) or set in your host (Vercel/Netlify) for production.
# ============================================

# --- Supabase (existing) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- App URL (used to build the Cashfree return URL) ---
# No trailing slash. e.g. https://app.anutask.com  (dev: http://localhost:3000)
NEXT_PUBLIC_APP_URL=https://app.anutask.com

# --- Cashfree Payment Gateway ---
# Get these from Cashfree Merchant Dashboard → Developers → API Keys.
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
# 'sandbox' while testing, 'production' when live
CASHFREE_ENV=sandbox

# Payments UI feature flag.
# Keep this FALSE (or unset) until Cashfree Payment Gateway is approved on your
# merchant account. When false, the plan cards show a disabled "Payment Gateway
# Coming Soon" button and hide the coupon field. Flip to 'true' the day Cashfree
# activates your PG product — no code deploy needed, just re-deploy the env.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# --- Admin coupon panel ---
# Any strong secret. You enter this in the Admin Panel to manage coupons.
ADMIN_PANEL_SECRET=set_a_long_random_secret_here

# --- Super Admin panel access ---
# Comma-separated list of emails allowed to sign into /admin-panel-9x7k2m.
# An account must BE in this list AND have a row in the admin_users table
# (see supabase-migration-v4-admin.sql) to gain access. A normal user who
# logs in at the admin URL is rejected and signed out automatically.
# Set the SAME emails you seed into admin_users.
ADMIN_EMAILS=admin@anutask.com
# Optional: the client also reads this to pre-gate the login form.
NEXT_PUBLIC_ADMIN_EMAILS=admin@anutask.com
